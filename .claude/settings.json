{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-queue-on-start.mjs",
            "timeout": 15,
            "statusMessage": "Checking the ticket board for fixed-but-unverified issues…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/no-blanket-git-add.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/test-touched-module.mjs" }
        ]
      }
    ]
  }
}
