# Copy to .env.local and fill in the values from the Firebase Console:
# Project settings > General > Your apps (Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=activklass1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=activklass1
VITE_FIREBASE_STORAGE_BUCKET=activklass1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave unset for local dev -- Vite proxies /api to Flask on port 5000, which
# also makes a forwarded/tunnelled port work. Set only for a deployed API.
# VITE_API_URL=
