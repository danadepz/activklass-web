# Copy to .env.local. Defaults below target the local Firebase Emulator Suite
# (firebase emulators:start) under the "demo-activklass" project — no real
# Firebase project, login, or API keys needed. Values can be anything when
# VITE_FIREBASE_EMULATOR=true; they're only real if you point at production
# (Firebase Console > Project settings > General > Your apps (Web app)).
VITE_FIREBASE_API_KEY="demo-api-key"
VITE_FIREBASE_AUTH_DOMAIN="demo-activklass.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="demo-activklass"
VITE_FIREBASE_STORAGE_BUCKET="demo-activklass.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

VITE_API_URL=http://localhost:5000

# Use the local Firebase emulator suite (firebase emulators:start).
# Set to false (or remove) to hit the real activklass-dev project.
VITE_FIREBASE_EMULATOR=true
